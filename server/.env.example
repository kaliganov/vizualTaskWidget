HOST=127.0.0.1
PORT=3001
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=visualtask
DATABASE_PASSWORD=visualtask
DATABASE_NAME=visualtask
# На портале — секрет, которым портал подписывает JWT (HS256). Плейсхолдер в production не принимается.
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=7d
DEMO_COMPANY_ID=demo-company
# Локальное демо ходит от основателя. На портале не задавать: при NODE_ENV=production флаг всё равно не действует.
DEMO_ACTOR=true
# Через запятую. Пусто: локально только 127.0.0.1:5173 и localhost:5173, в production — никого.
# CORS_ORIGINS=https://portal.example
